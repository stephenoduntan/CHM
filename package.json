{
  "name": "chm-platform",
  "version": "1.0.0",
  "private": true,
  "description": "RCCG Court of His Majesty — Monorepo Platform for Website & Admin Studio",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:admin": "npm run build --workspace=admin",
    "start": "npm run start --workspace=web",
    "start:web": "npm run start --workspace=web",
    "start:admin": "npm run start --workspace=admin",
    "lint": "npm run lint --workspace=web"
  },
  "dependencies": {
    "@sanity/client": "^7.28.0",
    "@sanity/image-url": "^2.1.1"
  }
}
